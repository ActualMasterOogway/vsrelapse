{
  "name": "vsrelapse",
  "displayName": "Relapse",
  "description": "VS Code-native Relapse script executor, output/rconsole bridge, and profile/account manager",
  "version": "0.1.0",
  "publisher": "ActualMasterOogway",
  "author": {
    "name": "ActualMasterOogway",
    "url": "https://github.com/ActualMasterOogway"
  },
  "license": "GPL-3.0-or-later",
  "icon": "resources/icons/icon.png",
  "galleryBanner": {
    "color": "#0d1117",
    "theme": "dark"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/ActualMasterOogway/vsrelapse.git"
  },
  "homepage": "https://github.com/ActualMasterOogway/vsrelapse#readme",
  "bugs": {
    "url": "https://github.com/ActualMasterOogway/vsrelapse/issues"
  },
  "keywords": [
    "relapse",
    "roblox",
    "luau",
    "lua"
  ],
  "engines": {
    "vscode": "^1.95.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onStartupFinished"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "relapse",
          "title": "Relapse",
          "icon": "resources/icons/relapse.svg"
        }
      ]
    },
    "views": {
      "relapse": [
        {
          "id": "relapse.sessions",
          "name": "Sessions"
        },
        {
          "id": "relapse.profiles",
          "name": "Profiles"
        },
        {
          "id": "relapse.scripts",
          "name": "Scripts"
        }
      ]
    },
    "commands": [
      {
        "command": "relapse.executeActive",
        "category": "Relapse",
        "title": "Execute Active Editor",
        "icon": "$(play)"
      },
      {
        "command": "relapse.executeSelection",
        "category": "Relapse",
        "title": "Execute Selection",
        "icon": "$(play)"
      },
      {
        "command": "relapse.executeFile",
        "category": "Relapse",
        "title": "Execute Script",
        "icon": "$(play)"
      },
      {
        "command": "relapse.showOutput",
        "category": "Relapse",
        "title": "Show Output",
        "icon": "$(list-unordered)"
      },
      {
        "command": "relapse.refreshSessions",
        "category": "Relapse",
        "title": "Refresh Sessions",
        "icon": "$(refresh)"
      },
      {
        "command": "relapse.toggleOutput",
        "category": "Relapse",
        "title": "Toggle Output Redirection",
        "icon": "$(output)"
      },
      {
        "command": "relapse.openConsole",
        "category": "Relapse",
        "title": "Open rconsole Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "relapse.selectTargets",
        "category": "Relapse",
        "title": "Select Target Sessions",
        "icon": "$(plug)"
      },
      {
        "command": "relapse.refreshProfiles",
        "category": "Relapse",
        "title": "Refresh Profiles",
        "icon": "$(refresh)"
      },
      {
        "command": "relapse.createProfile",
        "category": "Relapse",
        "title": "New Profile",
        "icon": "$(add)"
      },
      {
        "command": "relapse.launchProfile",
        "category": "Relapse",
        "title": "Launch Profile",
        "icon": "$(rocket)"
      },
      {
        "command": "relapse.launchProfileToPlace",
        "category": "Relapse",
        "title": "Launch to Place / Job ID",
        "icon": "$(link-external)"
      },
      {
        "command": "relapse.importCookie",
        "category": "Relapse",
        "title": "Import .ROBLOSECURITY Cookie",
        "icon": "$(key)"
      },
      {
        "command": "relapse.refreshAccount",
        "category": "Relapse",
        "title": "Refresh Account Info",
        "icon": "$(sync)"
      },
      {
        "command": "relapse.renameProfile",
        "category": "Relapse",
        "title": "Rename Profile",
        "icon": "$(edit)"
      },
      {
        "command": "relapse.deleteProfile",
        "category": "Relapse",
        "title": "Delete Profile",
        "icon": "$(trash)"
      },
      {
        "command": "relapse.refreshScripts",
        "category": "Relapse",
        "title": "Refresh Scripts",
        "icon": "$(refresh)"
      },
      {
        "command": "relapse.newScript",
        "category": "Relapse",
        "title": "New Script",
        "icon": "$(new-file)"
      },
      {
        "command": "relapse.deleteScript",
        "category": "Relapse",
        "title": "Delete Script",
        "icon": "$(trash)"
      }
    ],
    "keybindings": [
      {
        "command": "relapse.executeActive",
        "key": "ctrl+alt+r",
        "when": "editorTextFocus"
      },
      {
        "command": "relapse.executeSelection",
        "key": "ctrl+alt+shift+r",
        "when": "editorTextFocus && editorHasSelection"
      }
    ],
    "menus": {
      "editor/title": [
        {
          "command": "relapse.executeActive",
          "group": "navigation",
          "when": "editorTextFocus"
        }
      ],
      "editor/context": [
        {
          "command": "relapse.executeActive",
          "group": "1_modification"
        },
        {
          "command": "relapse.executeSelection",
          "group": "1_modification",
          "when": "editorHasSelection"
        }
      ],
      "view/title": [
        {
          "command": "relapse.showOutput",
          "group": "navigation",
          "when": "view == relapse.sessions"
        },
        {
          "command": "relapse.toggleOutput",
          "group": "navigation",
          "when": "view == relapse.sessions"
        },
        {
          "command": "relapse.refreshSessions",
          "group": "navigation",
          "when": "view == relapse.sessions"
        },
        {
          "command": "relapse.createProfile",
          "group": "navigation",
          "when": "view == relapse.profiles"
        },
        {
          "command": "relapse.refreshProfiles",
          "group": "navigation",
          "when": "view == relapse.profiles"
        },
        {
          "command": "relapse.refreshScripts",
          "group": "navigation",
          "when": "view == relapse.scripts"
        }
      ],
      "view/item/context": [
        {
          "command": "relapse.openConsole",
          "group": "inline",
          "when": "view == relapse.sessions && viewItem == session"
        },
        {
          "command": "relapse.openConsole",
          "group": "inline",
          "when": "view == relapse.profiles && viewItem == profileRunning"
        },
        {
          "command": "relapse.launchProfile",
          "group": "inline",
          "when": "view == relapse.profiles && viewItem == profile"
        },
        {
          "command": "relapse.launchProfileToPlace",
          "group": "1_launch",
          "when": "view == relapse.profiles && viewItem == profile"
        },
        {
          "command": "relapse.importCookie",
          "group": "2_account",
          "when": "view == relapse.profiles && viewItem =~ /^profile/"
        },
        {
          "command": "relapse.refreshAccount",
          "group": "2_account",
          "when": "view == relapse.profiles && viewItem =~ /^profile/"
        },
        {
          "command": "relapse.renameProfile",
          "group": "3_manage",
          "when": "view == relapse.profiles && viewItem =~ /^profile/"
        },
        {
          "command": "relapse.deleteProfile",
          "group": "3_manage",
          "when": "view == relapse.profiles && viewItem =~ /^profile/"
        },
        {
          "command": "relapse.newScript",
          "group": "inline",
          "when": "view == relapse.scripts && viewItem == scriptFolder"
        },
        {
          "command": "relapse.executeFile",
          "group": "inline",
          "when": "view == relapse.scripts && viewItem == scriptFile"
        },
        {
          "command": "relapse.deleteScript",
          "group": "2_manage",
          "when": "view == relapse.scripts && viewItem == scriptFile"
        }
      ]
    },
    "configuration": {
      "title": "Relapse",
      "properties": {
        "relapse.launcherPath": {
          "type": "string",
          "default": "",
          "description": "Absolute path to the Relapse launcher executable."
        },
        "relapse.scriptsDir": {
          "type": "string",
          "default": "~/.local/share/relapse/scripts",
          "description": "Directory for Relapse scripts."
        },
        "relapse.redirectOutput": {
          "type": "boolean",
          "default": true,
          "description": "Enable vsrelapse.session.v2 output redirection from in-game scripts."
        },
        "relapse.autoOpenConsole": {
          "type": "boolean",
          "default": true,
          "description": "Automatically show the rconsole terminal when a script calls rconsoleshow or rconsoleprint."
        },
        "relapse.autoTargetFirst": {
          "type": "boolean",
          "default": true,
          "description": "Automatically target the first ready session when no sessions are selected."
        }
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "compile": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "test": "tsc -p tsconfig.test.json && node --test .test-build/test/*.test.js"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/vscode": "^1.95.0",
    "esbuild": "^0.24.0",
    "typescript": "^5.7.0"
  }
}
